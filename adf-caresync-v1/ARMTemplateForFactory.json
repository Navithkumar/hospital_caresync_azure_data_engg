{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync-v1"
		},
		"AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-caresync-v1.vault.azure.net/"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncstoragev1.dfs.core.windows.net/"
		},
		"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1019-105512-1h7nfq1n"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresyncserverv1.database.windows.net"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-caresync"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "navith"
		},
		"LS_Postgres_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-misty-recipe-a1poipez-pooler.ap-southeast-1.aws.neon.tech"
		},
		"LS_Postgres_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_Postgres_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_SOURCE_TO_SILVER_INNER')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "READ TABLE DETAILS",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT * FROM ctrl.table_config WHERE table_id = @{pipeline().parameters.table_id}; ",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "SET VARIABLE",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "timestamp",
							"value": {
								"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "LANDING NOTEBOOK BRONZE",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Check Source System",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/caresync_repo/hospital_caresync_azure_data_engg/databricks/landing_to_bronze",
							"baseParameters": {
								"source_system": {
									"value": "@activity('READ TABLE DETAILS').output.firstRow.source_system",
									"type": "Expression"
								},
								"table_name": {
									"value": "@activity('READ TABLE DETAILS').output.firstRow.bronze_table_name",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('timestamp')",
									"type": "Expression"
								},
								"source_file_format": {
									"value": "@coalesce(activity('READ TABLE DETAILS').output.firstRow.source_file_format,'')",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_AzureDatabricks",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "LANDING NOTEBOOK SILVER",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "LANDING NOTEBOOK BRONZE",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/caresync_repo/hospital_caresync_azure_data_engg/databricks/bronze_to_silver",
							"baseParameters": {
								"table_name": {
									"value": "@activity('READ TABLE DETAILS').output.firstRow.silver_table_name",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('timestamp')",
									"type": "Expression"
								},
								"load_type": {
									"value": "@activity('READ TABLE DETAILS').output.firstRow.load_type",
									"type": "Expression"
								},
								"merge_keys": {
									"value": "@coalesce(\n    activity('READ TABLE DETAILS').output.firstRow.merge_keys,''\n)",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_AzureDatabricks",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Update Success Status",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Check load type and update watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_AzureSqlDatabase",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "UPDATE ctrl.audit_log \nSET status = 'SUCCESS',end_time = SYSUTCDATETIME() ,records_written = @{activity('LANDING NOTEBOOK SILVER').output.runOutput}\nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}' and table_id = @{pipeline().parameters.table_id}",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "If Condition1",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "READ TABLE DETAILS",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "SET VARIABLE",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(activity('READ TABLE DETAILS').output.firstRow.load_type,'FULL'))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Read Watermark",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "SELECT watermark_value FROM ctrl.watermark where table_id = @{pipeline().parameters.table_id}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "AzureSqlTable1",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "Store watermark table",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Read Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "watermark value",
										"value": {
											"value": "@activity('Read Watermark').output.firstRow.watermark_value",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "Check load type and update watermark",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "LANDING NOTEBOOK SILVER",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(\n    equals(activity('READ TABLE DETAILS').output.firstRow.load_type,'FULL')\n)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "update watermark",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_AzureSqlDatabase",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE ctrl.watermark \nSET watermark_value = SYSDATETIME() \nwhere table_id = @{pipeline().parameters.table_id};",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					},
					{
						"name": "Check Source System",
						"type": "Switch",
						"dependsOn": [
							{
								"activity": "If Condition1",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"on": {
								"value": "@activity('READ TABLE DETAILS').output.firstRow.source_system",
								"type": "Expression"
							},
							"cases": [
								{
									"value": "neon_postgres",
									"activities": [
										{
											"name": "SOURCE_TO_LANDING_INGESTION",
											"type": "Copy",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"source": {
													"type": "PostgreSqlV2Source",
													"query": {
														"value": "SELECT * FROM PUBLIC.@{activity('READ TABLE DETAILS').output.firstRow.source_table_name}\n@{\n    if(\n        or(\n            equals(toLower(trim(activity('READ TABLE DETAILS').output.firstRow.load_type)), 'full'),\n            empty(activity('READ TABLE DETAILS').output.firstRow.watermark_column)\n        ),\n        '',\n        concat(\n            ' WHERE ',\n            activity('READ TABLE DETAILS').output.firstRow.watermark_column,\n            ' > ''',\n            variables('watermark value'),\n            ''''\n        )\n    )\n}",
														"type": "Expression"
													},
													"queryTimeout": "02:00:00"
												},
												"sink": {
													"type": "ParquetSink",
													"storeSettings": {
														"type": "AzureBlobFSWriteSettings"
													},
													"formatSettings": {
														"type": "ParquetWriteSettings"
													}
												},
												"enableStaging": false,
												"translator": {
													"type": "TabularTranslator",
													"typeConversion": true,
													"typeConversionSettings": {
														"allowDataTruncation": true,
														"treatBooleanAsNumber": false
													}
												}
											},
											"inputs": [
												{
													"referenceName": "DS_PostgreSql",
													"type": "DatasetReference",
													"parameters": {}
												}
											],
											"outputs": [
												{
													"referenceName": "LS_DS_Parquet",
													"type": "DatasetReference",
													"parameters": {
														"container": "landing",
														"folder": {
															"value": "@concat(\n    activity('READ TABLE DETAILS').output.firstRow.source_system,\n    '/',\n    activity('READ TABLE DETAILS').output.firstRow.source_table_name,\n    '/',\n    variables('timestamp')\n\n)",
															"type": "Expression"
														}
													}
												}
											]
										}
									]
								},
								{
									"value": "adls_csv",
									"activities": [
										{
											"name": "SOURCE_TO_LANDING_INGESTION_CSV",
											"type": "Copy",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"source": {
													"type": "BinarySource",
													"storeSettings": {
														"type": "AzureBlobFSReadSettings",
														"recursive": false,
														"modifiedDatetimeStart": {
															"value": "@variables('watermark value')",
															"type": "Expression"
														},
														"deleteFilesAfterCompletion": false
													},
													"formatSettings": {
														"type": "BinaryReadSettings"
													}
												},
												"sink": {
													"type": "BinarySink",
													"storeSettings": {
														"type": "AzureBlobFSWriteSettings"
													}
												},
												"enableStaging": false
											},
											"inputs": [
												{
													"referenceName": "Binary_csv",
													"type": "DatasetReference",
													"parameters": {
														"folder": {
															"value": "@activity('READ TABLE DETAILS').output.firstRow.source_path",
															"type": "Expression"
														},
														"container": "source"
													}
												}
											],
											"outputs": [
												{
													"referenceName": "Binary_csv",
													"type": "DatasetReference",
													"parameters": {
														"folder": {
															"value": "@concat(\n    activity('READ TABLE DETAILS').output.firstRow.source_system,\n    '/',\n    activity('READ TABLE DETAILS').output.firstRow.source_table_name,\n    '/',\n    variables('timestamp')\n\n)",
															"type": "Expression"
														},
														"container": "landing"
													}
												}
											]
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_id": {
						"type": "string",
						"defaultValue": "1"
					},
					"adf_run_id": {
						"type": "string",
						"defaultValue": "a1"
					}
				},
				"variables": {
					"timestamp": {
						"type": "String"
					},
					"watermark value": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureDatabricks')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSqlDatabase')]",
				"[concat(variables('factoryId'), '/datasets/DS_PostgreSql')]",
				"[concat(variables('factoryId'), '/datasets/LS_DS_Parquet')]",
				"[concat(variables('factoryId'), '/datasets/Binary_csv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_SOURCE_TO_SILVER_MAIN')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read Source Tables Lists",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT table_id FROM ctrl.table_config WHERE is_active = 1 AND source_system = '@{pipeline().parameters.source_system_db}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "Ingest All Tabels",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Read Source Tables Lists",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Read Source Tables Lists').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "Ingest from Source To Table",
									"type": "ExecutePipeline",
									"dependsOn": [
										{
											"activity": "Insert in Progess Status",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_SOURCE_TO_SILVER_INNER",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"table_id": {
												"value": "@item().table_id",
												"type": "Expression"
											},
											"adf_run_id": {
												"value": "@pipeline().parameters.adf_run_id",
												"type": "Expression"
											}
										}
									}
								},
								{
									"name": "Insert in Progess Status",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_AzureSqlDatabase",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "INSERT INTO ctrl.audit_log \n(adf_run_id,table_id,stage,status,start_time) VALUES \n('@{pipeline().parameters.adf_run_id}',@{item().table_id},'SOURCE_TO_SILVER','IN_PROGRESS',SYSUTCDATETIME())",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "Update Failed Status",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "Ingest from Source To Table",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_AzureSqlDatabase",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE ctrl.audit_log \nSET status = 'FAILED',end_time = SYSUTCDATETIME() \nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}' and table_id = @{item().table_id}",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "Update pipeline as failed",
									"type": "Fail",
									"dependsOn": [
										{
											"activity": "Ingest from Source To Table",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"message": "Inner Pipeline Failed",
										"errorCode": "500"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"source_system_db": {
						"type": "string",
						"defaultValue": "adls_csv"
					},
					"adf_run_id": {
						"type": "string",
						"defaultValue": "a2"
					}
				},
				"variables": {
					"table_id": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/pipelines/PL_SOURCE_TO_SILVER_INNER')]",
